# Copy to .env and adjust. The values below match docker-compose.yml.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://analyst:analyst@localhost:5440/analyst

# Gemini API key from Google AI Studio. Needed for answering questions.
GOOGLE_API_KEY=
# Any Gemini model. See the model comparison in the README for accuracy, speed and cost.
LLM_MODEL=gemini-3.5-flash
